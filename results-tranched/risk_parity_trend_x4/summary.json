  "meta": {
    "description": "Inverse-volatility (risk parity) weights over six global asset-class ETFs (SPY, EFA, EEM, IEF, DBC, VNQ) from the standard deviation of the last 12 monthly returns. An asset whose month-end close is at or below its 10-month SMA has its weight moved to T-bills (BIL). Rebalanced monthly, unlevered. Run as 4 equal tranches deciding 5 sessions apart, to remove rebalance-timing luck.",
    "references": [
      {
        "citation": "Clare, A., Seaton, J., Smith, P.N., Thomas, S. (2016), The trend is our friend: Risk parity, momentum and trend following in global asset allocation, Journal of Behavioral and Experimental Finance 9, 63-80 (SSRN 2126478, first posted 2012)",
        "url": "https://doi.org/10.1016/j.jbef.2016.01.002"
      },
      {
        "citation": "Asness, C., Frazzini, A., Pedersen, L.H. (2012), Leverage Aversion and Risk Parity, Financial Analysts Journal 68(1), 47-59",
        "url": "https://doi.org/10.2469/faj.v68.n1.1"
      },
      {
        "citation": "Faber, M. (2007), A Quantitative Approach to Tactical Asset Allocation, Journal of Wealth Management 9(4), 69-79",
        "url": "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=962461"
      },
      {
        "citation": "Hoffstein, C., Faber, N., Braun, S. (2020), Rebalance Timing Luck: The (Dumb) Luck of Smart Beta, SSRN 3673910",
        "url": "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=3673910"
      }
    ],
